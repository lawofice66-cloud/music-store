# ==============================================================================
# FALLEN 75 FRANCE – Configuration des Variables d'Environnement
# ==============================================================================
# ATTENTION : Ne commitez jamais vos vraies clés secrètes dans GitHub.
# Ce fichier sert de modèle : toutes les valeurs sont intentionnellement laissées vides.
# Sur Cloudflare Pages, configurez ces variables dans :
# Dashboard Cloudflare > Workers & Pages > fallen-75-france > Settings > Environment Variables & Bindings
# ==============================================================================

# --- Sécurité & Administration ---
# Mot de passe pour déverrouiller l'espace d'administration du catalogue et des paiements
ADMIN_PASSWORD=

# Clé secrète aléatoire utilisée pour signer les sessions et jetons d'administration
ADMIN_SESSION_SECRET=

# --- Base de Données Cloudflare D1 ---
# L'identifiant UUID de votre base D1 (généré avec: npx wrangler d1 create fallen75_db)
# Dans Cloudflare Pages, lié via le Binding D1 nommé "DB"
CLOUDFLARE_D1_DATABASE_ID=

# --- Stockage Fichiers Audio & Images Cloudflare R2 ---
# Dans Cloudflare Pages, lié directement via le Binding R2 nommé "R2_BUCKET"
# Les variables suivantes sont requises pour les accès directs S3 / scripts de synchronisation
CF_R2_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET_NAME=

# Domaine public ou URL r2.dev pour servir les fichiers audio et pochettes (optionnel)
CF_R2_PUBLIC_URL=

# --- Paramètres Système AI Studio ---
GEMINI_API_KEY=
APP_URL=
